rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "sourarajp@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    
    function isValidIssue(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.location is string && data.location.size() <= 200 &&
             data.severity in ['Low', 'Medium', 'High', 'Critical'] &&
             data.priority in ['Low', 'Medium', 'High', 'Urgent'] &&
             data.status in ['Open', 'In Progress', 'Resolved', 'Closed'];
    }

    function isValidVolunteer(data) {
      return data.fullName is string && data.fullName.size() <= 100 &&
             data.skills is list && data.skills.size() <= 20 &&
             data.status in ['Available', 'Busy', 'Inactive'];
    }

    function isValidAssignment(data) {
      return data.issueId is string && data.volunteerId is string &&
             data.status in ['Assigned', 'Accepted', 'Completed', 'Cancelled'];
    }

    // --- Match Blocks ---

    // Collection: Issues
    match /issues/{issueId} {
      allow read: if true;
      allow create: if true && isValidId(issueId);
      allow update: if true;
      allow delete: if true;
    }

    // Collection: Volunteers
    match /volunteers/{volunteerId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Collection: Assignments
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create: if true && isValidId(assignmentId);
      allow update: if true;
      allow delete: if true;
    }
  }
}
